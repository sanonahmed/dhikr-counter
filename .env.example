# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- AI notification studio (server-side, optional) -------------------------
# server.js uses these so AI requests can be proxied with a server-side key.
# AI_API_KEY falls back to OPENAI_API_KEY and then GEMINI_API_KEY.
# AI_BASE_URL must be an OpenAI-compatible base URL; /chat/completions is added.
# When only GEMINI_API_KEY is set, the Gemini OpenAI-compatible endpoint is used.
# AI_API_KEY="MY_PROVIDER_KEY"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# AI_ALLOWED_HOSTS is required for custom provider hosts not in the built-in list.
# Use exact hostnames only (no https:// or path), comma-separated; example:
# AI_ALLOWED_HOSTS="api.deepinfra.com,custom.example.org"
# In development, server.js reloads this file on save, so no restart is needed.
# AI_PROXY_ORIGINS="https://dhikr-counter.onrender.com"
# Set AI_PROXY_ORIGINS on the Node proxy service to the exact origin of a static frontend.
# This enables CORS only for that frontend and lets it use the server-side key.
# For a public shared proxy that accepts client-provided keys only, you may use "*".
# --- Frontend (Vite, build time only) ---------------------------------------
# VITE_AI_PROXY_URL points a static build at a deployed Node copy of this app.
# VITE_AI_PROXY_URL="https://your-node-service.onrender.com"
