# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Private admin panel (server-verified) ----------------------------------
# ADMIN_PASSCODE unlocks the hidden admin panel (AI notification studio).
# Leave it unset to disable the panel entirely: /api/admin/login answers 503 and
# /api/ai/chat refuses every request, so a server-side AI key stays unused.
# ADMIN_SESSION_HOURS is how long a login lasts (default 12, max 168).
# Sessions live in memory only, so restarting server.js signs everyone out.
# ADMIN_PASSCODE="change-me-to-a-long-random-string"
# ADMIN_SESSION_HOURS="12"

# --- Web push broadcasts (admin panel -> every registered device) -----------
# VAPID keys authenticate the push service. Generate once and keep them stable:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Set up PostgreSQL (Neon recommended) and use its connection string. The server
# applies migrations/001_push_subscriptions.sql automatically on first connection.
# Push is disabled until DATABASE_URL and a stable VAPID keypair are configured.
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@example.com"

# --- AI provider keys used by the admin panel's proxy -----------------------
# server.js uses these so the browser never holds a provider key.
# AI_API_KEY falls back to OPENAI_API_KEY and then GEMINI_API_KEY.
# AI_BASE_URL must be an OpenAI-compatible base URL; /chat/completions is added.
# When only GEMINI_API_KEY is set, the Gemini OpenAI-compatible endpoint is used.
# AI_API_KEY="MY_PROVIDER_KEY"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# The same AI settings power the public "AI Talk" companion in the app header.
# AI Talk only uses server-side settings (never a browser-supplied key) and is
# rate-limited per IP, so keep the provider key's budget in mind.
# AI_ALLOWED_HOSTS is required for custom provider hosts not in the built-in list.
# Use exact hostnames only (no https:// or path), comma-separated; example:
# AI_ALLOWED_HOSTS="api.deepinfra.com,custom.example.org"
# In development, server.js reloads this file on save, so no restart is needed.
# AI_PROXY_ORIGINS="https://dhikr-counter.onrender.com"
# Set AI_PROXY_ORIGINS on the Node proxy service to the exact origin of a static frontend.
# This enables CORS for that frontend, which still needs an admin bearer token to
# use /api/ai/chat. "*" only reflects origins; it never grants the admin session.
# --- Frontend (Vite, build time only) ---------------------------------------
# VITE_AI_PROXY_URL points a static build at a deployed Node copy of this app so
# the hidden admin panel knows where to sign in.
# VITE_AI_PROXY_URL="https://your-node-service.onrender.com"
